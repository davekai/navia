+    /// paints the quads and shadows `f` draws at the fractional bounds they are given rather than
+    /// on whole device pixels, for shapes whose size moves smoothly, such as a bar growing.
+    pub fn with_exact_paint<R>(&mut self, f: impl FnOnce(&mut Self) -> R) -> R {
+        let previous = std::mem::replace(&mut self.next_frame.scene.exact, true);
+        let result = f(self);
+        self.next_frame.scene.exact = previous;
+        result
+    }
+
+    /// a shadow's bounds: on device pixels that cover it, or as given inside `with_exact_paint`.
+    fn shadow_bounds(&self, bounds: Bounds<Pixels>) -> Bounds<ScaledPixels> {
+        if self.next_frame.scene.exact { bounds.scale(self.scale_factor()) } else { self.cover_bounds(bounds) }
+    }
