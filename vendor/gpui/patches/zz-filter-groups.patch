+
+/*
+**
+**              Filter groups
+**
+*/
+
+// a composite reads the cbuffer above as `FilterGroup` in directx_renderer/filter_groups.rs
+// fills it: backdrop_bounds is the mask rect and backdrop_clip.y switches it on,
+// backdrop_content_mask the rect composited, and backdrop_region_origin where the image's first
+// texel lands (the group's offset included).
+
+BackdropBlurPassVertexOutput filter_clear_vertex(uint vertex_id: SV_VertexID) {
+    return backdrop_blur_pass_vertex(vertex_id);
+}
+
+// drawn with blending off over a viewport the size of the region: empties it.
+float4 filter_clear_fragment(BackdropBlurPassVertexOutput input): SV_Target {
+    return float4(0., 0., 0., 0.);
+}
+
+BackdropBlurPassVertexOutput filter_composite_vertex(uint vertex_id: SV_VertexID) {
+    float2 unit_vertex = float2(float(vertex_id & 1u), 0.5 * float(vertex_id & 2u));
+    BackdropBlurPassVertexOutput output;
+    output.position = to_device_position(unit_vertex, backdrop_content_mask);
+    return output;
+}
+
+// the image holds premultiplied colour and is blended over the target as such.
+float4 filter_composite_fragment(BackdropBlurPassVertexOutput input): SV_Target {
+    float2 position = input.position.xy;
+    float2 local = position - backdrop_region_origin;
+    float4 color = sample_backdrop(t_backdrop_blurred, (local - 0.5) / backdrop_scale + 0.5);
+    float coverage = saturate(backdrop_opacity) * rounded_clip_coverage(backdrop_clip.x, position);
+    if (backdrop_clip.y != 0u) {
+        coverage *= saturate(0.5 - quad_sdf(position, backdrop_bounds, backdrop_corner_radii));
+    }
+    return color * coverage;
+}
