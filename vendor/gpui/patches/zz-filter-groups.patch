+/// a scene's backdrop blurs and filter groups not yet drawn, in draw order.
+struct SceneEffects<'a> {
+    blurs: std::iter::Peekable<std::slice::Iter<'a, BackdropBlur>>,
+    groups: std::iter::Peekable<std::iter::Zip<std::slice::Iter<'a, FilterGroup>, std::slice::Iter<'a, SceneInstances>>>,
