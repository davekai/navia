+/// `bounds` grown to whole device pixels and cut to a `size` target, or `None` when nothing is left.
+fn device_rect(bounds: Bounds<ScaledPixels>, size: Size<u32>) -> Option<Bounds<u32>> {
+    if !(bounds.size.width.0 > 0. && bounds.size.height.0 > 0.) {
+        return None;
+    }
+    let left = bounds.origin.x.0.floor().max(0.) as u32;
+    let top = bounds.origin.y.0.floor().max(0.) as u32;
+    let right = (bounds.right().0.ceil().max(0.) as u32).min(size.width);
+    let bottom = (bounds.bottom().0.ceil().max(0.) as u32).min(size.height);
+    (right > left && bottom > top).then(|| Bounds {
+        origin: Point { x: left, y: top },
+        size: Size { width: right - left, height: bottom - top },
+    })
+}
