+
+impl SceneEffects<'_> {
+    /// whether an effect is due before the primitives of `order`.
+    fn due_before(&mut self, order: DrawOrder) -> bool {
+        self.next_due(Some(order)).is_some()
+    }
+
+    /// the next effect if it is due before the primitives of `before` (or at all, for `None`):
+    /// whether it is a blur, and its order.
+    fn next_due(&mut self, before: Option<DrawOrder>) -> Option<(bool, DrawOrder)> {
+        // blurs sort before the primitives of their order (rank 0), groups after them (rank 2)
+        let blur = self.blurs.peek().map(|blur| (blur.order, 0u8));
+        let group = self.groups.peek().map(|(group, _)| (group.order, 2u8));
+        let next = match (blur, group) {
+            (None, None) => return None,
+            (Some(blur), None) => blur,
+            (None, Some(group)) => group,
+            (Some(blur), Some(group)) => blur.min(group),
+        };
+        if before.is_some_and(|order| next >= (order, 1)) {
+            return None;
+        }
+        Some((next.1 == 0, next.0))
+    }
