diff -ruN -x 'LICENSE*' a/crates/gpui_windows/src/directx_renderer/filter_groups.rs b/crates/gpui_windows/src/directx_renderer/filter_groups.rs
--- a/crates/gpui_windows/src/directx_renderer/filter_groups.rs
+++ b/crates/gpui_windows/src/directx_renderer/filter_groups.rs
@@ -0,0 +1,379 @@
+// filter groups: a group's scene is drawn into a frame-sized target of its own, blurred with
+// the backdrop blur's passes and composited over the target it belongs to, premultiplied.
+use std::borrow::Cow;
+
+use super::backdrop_blur::{
+    BACKDROP_TAP_VECTORS, BackdropBlurParams, BackdropTexture, MAX_BACKDROP_BLUR_SIGMA,
+    gaussian_tap_pairs,
+};
+use super::*;
+
+/// drawn frames without a filter group after which the group targets are released.
+const FILTER_GROUP_IDLE_FRAMES: u32 = 120;
+/// groups nested deeper than this draw their content unfiltered, which bounds the frame-sized
+/// targets kept.
+const MAX_FILTER_GROUP_DEPTH: usize = 4;
+
+/// where a scene's primitives start in the uploaded buffers, and its groups', in the order of
+/// `Scene::filter_groups`.
+#[derive(Default)]
+pub(super) struct SceneBases {
+    pub(super) shadows: usize,
+    pub(super) quads: usize,
+    pub(super) underlines: usize,
+    pub(super) monochrome_sprites: usize,
+    pub(super) subpixel_sprites: usize,
+    pub(super) polychrome_sprites: usize,
+    pub(super) groups: Vec<SceneBases>,
+}
+
+/// the primitives uploaded for a frame: the scene's own when it has no groups, else every
+/// scene's one after another.
+#[derive(Default)]
+pub(super) struct ScenePrimitives<'a> {
+    pub(super) shadows: Cow<'a, [Shadow]>,
+    pub(super) quads: Cow<'a, [Quad]>,
+    pub(super) underlines: Cow<'a, [Underline]>,
+    pub(super) monochrome_sprites: Cow<'a, [MonochromeSprite]>,
+    pub(super) subpixel_sprites: Cow<'a, [SubpixelSprite]>,
+    pub(super) polychrome_sprites: Cow<'a, [PolychromeSprite]>,
+}
+
+impl<'a> ScenePrimitives<'a> {
+    pub(super) fn borrowed(scene: &'a Scene) -> Self {
+        Self {
+            shadows: Cow::Borrowed(&scene.shadows),
+            quads: Cow::Borrowed(&scene.quads),
+            underlines: Cow::Borrowed(&scene.underlines),
+            monochrome_sprites: Cow::Borrowed(&scene.monochrome_sprites),
+            subpixel_sprites: Cow::Borrowed(&scene.subpixel_sprites),
+            polychrome_sprites: Cow::Borrowed(&scene.polychrome_sprites),
+        }
+    }
+
+    /// appends `scene`'s primitives and then its groups', depth first.
+    pub(super) fn append(&mut self, scene: &Scene) -> SceneBases {
+        let mut bases = SceneBases {
+            shadows: self.shadows.len(),
+            quads: self.quads.len(),
+            underlines: self.underlines.len(),
+            monochrome_sprites: self.monochrome_sprites.len(),
+            subpixel_sprites: self.subpixel_sprites.len(),
+            polychrome_sprites: self.polychrome_sprites.len(),
+            groups: Vec::new(),
+        };
+        self.shadows.to_mut().extend_from_slice(&scene.shadows);
+        self.quads.to_mut().extend_from_slice(&scene.quads);
+        self.underlines.to_mut().extend_from_slice(&scene.underlines);
+        self.monochrome_sprites.to_mut().extend_from_slice(&scene.monochrome_sprites);
+        self.subpixel_sprites.to_mut().extend_from_slice(&scene.subpixel_sprites);
+        self.polychrome_sprites.to_mut().extend_from_slice(&scene.polychrome_sprites);
+        bases.groups = scene.filter_groups.iter().map(|group| self.append(&group.scene)).collect();
+        bases
+    }
+}
+
+struct FilterGroupPipeline {
+    clear_vertex: ID3D11VertexShader,
+    clear_fragment: ID3D11PixelShader,
+    composite_vertex: ID3D11VertexShader,
+    composite_fragment: ID3D11PixelShader,
+    replace_blend_state: ID3D11BlendState,
+    /// premultiplied over: a group's target holds premultiplied colour.
+    over_blend_state: ID3D11BlendState,
+}
+
+impl FilterGroupPipeline {
+    fn new(device: &ID3D11Device) -> Result<Self> {
+        let shader = |module, target| RawShaderBytes::new(module, target);
+        let clear_vertex = create_vertex_shader(device, shader(ShaderModule::FilterClear, ShaderTarget::Vertex)?.as_bytes())?;
+        let clear_fragment = create_fragment_shader(device, shader(ShaderModule::FilterClear, ShaderTarget::Fragment)?.as_bytes())?;
+        let composite_vertex = create_vertex_shader(device, shader(ShaderModule::FilterComposite, ShaderTarget::Vertex)?.as_bytes())?;
+        let composite_fragment = create_fragment_shader(device, shader(ShaderModule::FilterComposite, ShaderTarget::Fragment)?.as_bytes())?;
+        let mut replace = D3D11_BLEND_DESC::default();
+        replace.RenderTarget[0].BlendEnable = false.into();
+        replace.RenderTarget[0].RenderTargetWriteMask = D3D11_COLOR_WRITE_ENABLE_ALL.0 as u8;
+        let mut replace_blend_state = None;
+        unsafe { device.CreateBlendState(&replace, Some(&mut replace_blend_state))? };
+        let mut over = D3D11_BLEND_DESC::default();
+        let target = &mut over.RenderTarget[0];
+        target.BlendEnable = true.into();
+        target.BlendOp = D3D11_BLEND_OP_ADD;
+        target.BlendOpAlpha = D3D11_BLEND_OP_ADD;
+        target.SrcBlend = D3D11_BLEND_ONE;
+        target.SrcBlendAlpha = D3D11_BLEND_ONE;
+        target.DestBlend = D3D11_BLEND_INV_SRC_ALPHA;
+        target.DestBlendAlpha = D3D11_BLEND_INV_SRC_ALPHA;
+        target.RenderTargetWriteMask = D3D11_COLOR_WRITE_ENABLE_ALL.0 as u8;
+        let mut over_blend_state = None;
+        unsafe { device.CreateBlendState(&over, Some(&mut over_blend_state))? };
+        Ok(Self {
+            clear_vertex,
+            clear_fragment,
+            composite_vertex,
+            composite_fragment,
+            replace_blend_state: replace_blend_state.context("Creating filter clear blend state")?,
+            over_blend_state: over_blend_state.context("Creating filter composite blend state")?,
+        })
+    }
+}
+
+pub(super) struct FilterGroups {
+    /// none when the pipeline couldn't be built: groups then draw their content unfiltered.
+    pipeline: Option<FilterGroupPipeline>,
+    /// frame-sized targets, one per nesting depth.
+    targets: Vec<BackdropTexture>,
+    idle_frames: u32,
+}
+
+impl FilterGroups {
+    pub(super) fn new(device: &ID3D11Device) -> Self {
+        let pipeline = match FilterGroupPipeline::new(device) {
+            Ok(pipeline) => Some(pipeline),
+            Err(error) => {
+                // no logger may be installed; a console build of the app still shows this
+                eprintln!("gpui: filter groups unavailable on DirectX: {error:#}");
+                log::error!("filter groups unavailable on DirectX: {error:#}");
+                None
+            }
+        };
+        Self { pipeline, targets: Vec::new(), idle_frames: 0 }
+    }
+
+    /// counts a drawn frame against the group targets, releasing them once enough frames have
+    /// gone by without a group.
+    pub(super) fn note_frame(&mut self, frame_had_groups: bool) {
+        if frame_had_groups {
+            self.idle_frames = 0;
+            return;
+        }
+        if self.targets.is_empty() {
+            return;
+        }
+        self.idle_frames = self.idle_frames.saturating_add(1);
+        if self.idle_frames >= FILTER_GROUP_IDLE_FRAMES {
+            self.targets.clear();
+        }
+    }
+
+    pub(super) fn release_textures(&mut self) {
+        self.targets.clear();
+    }
+
+    /// the target groups at `depth` draw into, as texture, shader view and render target view.
+    fn target(
+        &mut self,
+        device: &ID3D11Device,
+        depth: usize,
+        size: (u32, u32),
+    ) -> Result<(ID3D11Texture2D, Option<ID3D11ShaderResourceView>, Option<ID3D11RenderTargetView>)> {
+        while self.targets.len() <= depth {
+            self.targets.push(BackdropTexture::new(device, size.0, size.1)?);
+        }
+        let target = &mut self.targets[depth];
+        if target.width != size.0 || target.height != size.1 {
+            *target = BackdropTexture::new(device, size.0, size.1)?;
+        }
+        Ok((target.texture.clone(), target.view.clone(), target.render_target_view.clone()))
+    }
+}
+
+/// `bounds` grown to whole pixels and cut to a `size` target, or `None` when nothing is left:
+/// left, top, right, bottom.
+fn device_rect(bounds: Bounds<ScaledPixels>, size: (u32, u32)) -> Option<(u32, u32, u32, u32)> {
+    if !(bounds.size.width.0 > 0. && bounds.size.height.0 > 0.) {
+        return None;
+    }
+    let left = bounds.origin.x.0.floor().max(0.) as u32;
+    let top = bounds.origin.y.0.floor().max(0.) as u32;
+    let right = (bounds.right().0.ceil().max(0.) as u32).min(size.0);
+    let bottom = (bounds.bottom().0.ceil().max(0.) as u32).min(size.1);
+    (right > left && bottom > top).then_some((left, top, right, bottom))
+}
+
+impl DirectXRenderer {
+    /// the texture and view batches draw into now: a group's target, or the frame's.
+    pub(super) fn current_target(
+        &self,
+        resources: &DirectXResources,
+    ) -> Result<(ID3D11Texture2D, Option<ID3D11RenderTargetView>)> {
+        match &self.target_override {
+            Some((texture, view)) => Ok((texture.clone(), view.clone())),
+            None => Ok((
+                resources.render_target.clone().context("render target missing")?,
+                resources.render_target_view.clone(),
+            )),
+        }
+    }
+
+    pub(super) fn current_target_view<'a>(
+        &'a self,
+        resources: &'a DirectXResources,
+    ) -> &'a Option<ID3D11RenderTargetView> {
+        match &self.target_override {
+            Some((_, view)) => view,
+            None => &resources.render_target_view,
+        }
+    }
+
+    /// draws `group`'s scene into its depth's target (emptying only the region it draws in),
+    /// blurs that region when the group has a blur, and composites it over the current target
+    /// moved by the group's offset. without the pipelines, or nested too deeply, the scene is
+    /// drawn straight into the current target instead.
+    pub(super) fn draw_filter_group(
+        &mut self,
+        group: &FilterGroup,
+        bases: &SceneBases,
+        depth: usize,
+    ) -> Result<()> {
+        if depth >= MAX_FILTER_GROUP_DEPTH
+            || self.filter_groups.pipeline.is_none()
+            || !self.backdrop_blurs.available()
+        {
+            return self.draw_scene(&group.scene, bases, depth);
+        }
+        let frame = (self.width, self.height);
+        let reach = group.blur_reach();
+        // one pixel more than the composite reaches, so the bilinear taps at its edge read cleared texels
+        let (Some(source), Some(composite)) = (
+            device_rect(group.bounds.dilate(ScaledPixels(reach as f32 + 2.)), frame),
+            device_rect(group.composite_bounds(), frame),
+        ) else {
+            return Ok(());
+        };
+        let devices = self.devices.clone().context("devices missing")?;
+        let device_context = &devices.device_context;
+        let (target_texture, target_view, target_rtv) =
+            self.filter_groups.target(&devices.device, depth, frame)?;
+        let full_viewport = self.resources.as_ref().context("resources missing")?.viewport;
+
+        {
+            let pipeline = self.filter_groups.pipeline.as_ref().context("filter pipeline missing")?;
+            let region = D3D11_VIEWPORT {
+                TopLeftX: source.0 as f32,
+                TopLeftY: source.1 as f32,
+                Width: (source.2 - source.0) as f32,
+                Height: (source.3 - source.1) as f32,
+                MinDepth: 0.0,
+                MaxDepth: 1.0,
+            };
+            unsafe {
+                // a texture bound for sampling is silently unbound when it becomes a render target
+                device_context.PSSetShaderResources(0, Some(&[None]));
+                device_context.PSSetShaderResources(4, Some(&[None]));
+                device_context.OMSetRenderTargets(Some(slice::from_ref(&target_rtv)), None);
+                device_context.RSSetViewports(Some(slice::from_ref(&region)));
+                device_context.IASetPrimitiveTopology(D3D_PRIMITIVE_TOPOLOGY_TRIANGLESTRIP);
+                device_context.VSSetShader(&pipeline.clear_vertex, None);
+                device_context.PSSetShader(&pipeline.clear_fragment, None);
+                device_context.OMSetBlendState(&pipeline.replace_blend_state, None, 0xFFFFFFFF);
+                device_context.Draw(4, 0);
+                device_context.RSSetViewports(Some(slice::from_ref(&full_viewport)));
+            }
+        }
+
+        let previous = self.target_override.replace((target_texture.clone(), target_rtv));
+        let drawn = self.draw_scene(&group.scene, bases, depth + 1);
+        self.target_override = previous;
+        drawn?;
+
+        let resources = self.resources.as_ref().context("resources missing")?;
+        let (_, parent_view) = self.current_target(resources)?;
+
+        let radii = group.mask_corner_radii.unwrap_or_default();
+        let mask = Bounds { origin: group.bounds.origin + group.offset, size: group.bounds.size };
+        let mut params = BackdropBlurParams {
+            bounds: [mask.origin.x.0, mask.origin.y.0, mask.size.width.0, mask.size.height.0],
+            corner_radii: [radii.top_left.0, radii.top_right.0, radii.bottom_right.0, radii.bottom_left.0],
+            content_mask: [
+                composite.0 as f32,
+                composite.1 as f32,
+                (composite.2 - composite.0) as f32,
+                (composite.3 - composite.1) as f32,
+            ],
+            region_origin: [group.offset.x.0, group.offset.y.0],
+            region_size: [frame.0 as f32, frame.1 as f32],
+            source_size: [frame.0 as f32, frame.1 as f32],
+            source_extent: [frame.0 as f32, frame.1 as f32],
+            direction: [0.; 2],
+            scale: [1.; 2],
+            saturation: 1.,
+            opacity: group.opacity,
+            center_weight: 1.,
+            tap_pair_count: 0,
+            fades: [0.; 4],
+            rounded_clip: group.rounded_clip,
+            has_mask: group.mask_corner_radii.is_some() as u32,
+            _pad: [0; 2],
+            taps: [[0.; 4]; BACKDROP_TAP_VECTORS],
+        };
+
+        let sigma = group.blur_radius.0.min(MAX_BACKDROP_BLUR_SIGMA);
+        let (width, height) = (source.2 - source.0, source.3 - source.1);
+        let downsample = ((sigma / 8.) as u32).clamp(1, 4);
+        let image = if reach > 0 {
+            let Some((blur_pipeline, textures)) =
+                self.backdrop_blurs.prepare(&devices.device, width, height, downsample)?
+            else {
+                return Ok(());
+            };
+            let (blurred_width, blurred_height) = (width.div_ceil(downsample), height.div_ceil(downsample));
+            let (center_weight, tap_pair_count) = gaussian_tap_pairs(sigma.max(0.5), &mut params.taps);
+            params.center_weight = center_weight;
+            params.tap_pair_count = tap_pair_count;
+            let region = D3D11_BOX { left: source.0, top: source.1, front: 0, right: source.2, bottom: source.3, back: 1 };
+            unsafe {
+                device_context.OMSetRenderTargets(None, None);
+                device_context.CopySubresourceRegion(&textures.source.texture, 0, 0, 0, 0, &target_texture, 0, Some(&region));
+                device_context.IASetPrimitiveTopology(D3D_PRIMITIVE_TOPOLOGY_TRIANGLESTRIP);
+                device_context.VSSetShader(&blur_pipeline.pass_vertex, None);
+                device_context.PSSetShader(&blur_pipeline.pass_fragment, None);
+                device_context.PSSetSamplers(1, Some(slice::from_ref(&blur_pipeline.sampler)));
+                device_context.VSSetConstantBuffers(2, Some(slice::from_ref(&blur_pipeline.params_buffer)));
+                device_context.PSSetConstantBuffers(2, Some(slice::from_ref(&blur_pipeline.params_buffer)));
+            }
+            params.source_size = [textures.source.width as f32, textures.source.height as f32];
+            params.source_extent = [width as f32, height as f32];
+            params.direction = [1., 0.];
+            params.scale = [downsample as f32, 1.];
+            blur_pipeline.draw_pass(device_context, &textures.horizontal, (blurred_width, height), &textures.source, &params)?;
+            params.source_size = [textures.horizontal.width as f32, textures.horizontal.height as f32];
+            params.source_extent = [blurred_width as f32, height as f32];
+            params.direction = [0., 1.];
+            params.scale = [1., downsample as f32];
+            blur_pipeline.draw_pass(device_context, &textures.blurred, (blurred_width, blurred_height), &textures.horizontal, &params)?;
+            params.source_size = [textures.blurred.width as f32, textures.blurred.height as f32];
+            params.source_extent = [blurred_width as f32, blurred_height as f32];
+            params.scale = [downsample as f32; 2];
+            params.region_origin = [source.0 as f32 + group.offset.x.0, source.1 as f32 + group.offset.y.0];
+            textures.blurred.view.clone()
+        } else {
+            target_view
+        };
+        let blur_pipeline = self.backdrop_blurs.pipeline().context("backdrop blur pipeline missing")?;
+
+        let pipeline = self.filter_groups.pipeline.as_ref().context("filter pipeline missing")?;
+        update_buffer(
+            device_context,
+            blur_pipeline.params_buffer.as_ref().context("backdrop blur params buffer missing")?,
+            slice::from_ref(&params),
+        )?;
+        unsafe {
+            device_context.PSSetShaderResources(0, Some(&[None]));
+            device_context.OMSetRenderTargets(Some(slice::from_ref(&parent_view)), None);
+            device_context.RSSetViewports(Some(slice::from_ref(&full_viewport)));
+            device_context.PSSetShaderResources(4, Some(slice::from_ref(&image)));
+            device_context.PSSetSamplers(1, Some(slice::from_ref(&blur_pipeline.sampler)));
+            device_context.VSSetConstantBuffers(2, Some(slice::from_ref(&blur_pipeline.params_buffer)));
+            device_context.PSSetConstantBuffers(2, Some(slice::from_ref(&blur_pipeline.params_buffer)));
+            device_context.IASetPrimitiveTopology(D3D_PRIMITIVE_TOPOLOGY_TRIANGLESTRIP);
+            device_context.VSSetShader(&pipeline.composite_vertex, None);
+            device_context.PSSetShader(&pipeline.composite_fragment, None);
+            device_context.OMSetBlendState(&pipeline.over_blend_state, None, 0xFFFFFFFF);
+            device_context.Draw(4, 0);
+            // the next group may render into the texture just sampled
+            device_context.PSSetShaderResources(4, Some(&[None]));
+        }
+        Ok(())
+    }
+}
