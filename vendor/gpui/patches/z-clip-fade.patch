+float clip_fade(float along, float2 a, float2 b) {
+    if (along < a.x) return a.y * along / max(a.x, 1e-4);
+    if (along < b.x) return lerp(a.y, b.y, (along - a.x) / max(b.x - a.x, 1e-4));
+    return lerp(b.y, 1.0, (along - b.x) / max(1.0 - b.x, 1e-4));
+}
