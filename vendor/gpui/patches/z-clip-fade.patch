+// opacity at `along` (0 at the clear edge, 1 at the opaque end) through stops `a` and `b`
+// (place, opacity), linear between them.
+fn clip_fade(along: f32, a: vec2<f32>, b: vec2<f32>) -> f32 {
+    if (along < a.x) { return a.y * along / max(a.x, 1e-4); }
+    if (along < b.x) { return mix(a.y, b.y, (along - a.x) / max(b.x - a.x, 1e-4)); }
+    return mix(b.y, 1.0, (along - b.x) / max(1.0 - b.x, 1e-4));
+}
