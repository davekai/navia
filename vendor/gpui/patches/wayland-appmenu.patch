+    fn set_app_menu_address(&self, service_name: &str, object_path: &str) {
+        let mut state = self.borrow_mut();
+        let Some(manager) = state.globals.kde_appmenu_manager.clone() else {
+            return;
+        };
+        if state.kde_appmenu.is_none() {
+            let appmenu = manager.create(&state.surface, &state.globals.qh, ());
+            state.kde_appmenu = Some(appmenu);
+        }
+        if let Some(appmenu) = &state.kde_appmenu {
+            appmenu.set_address(service_name.to_string(), object_path.to_string());
+        }
+    }
