+    /// draws what `f` paints scaled by `scale` around `origin`, then moved by `offset`, without
+    /// changing layout or hit testing: a press shrink, a cover easing to a size, a panel sliding in.
+    /// masks entered before stay where they are; masks inside move with the content. nested
+    /// transforms compose. replayed cached views keep the transform they were painted with.
+    pub fn with_paint_transform<R>(
+        &mut self,
+        scale: f32,
+        origin: Point<Pixels>,
+        offset: Point<Pixels>,
+        f: impl FnOnce(&mut Self) -> R,
+    ) -> R {
+        self.invalidator.debug_assert_paint_or_prepaint();
+        if !self.invalidator.is_painting() || (scale == 1.0 && offset == Point::default()) {
+            return f(self);
+        }
+        let sf = self.scale_factor();
+        let (o, d) = (origin.scale(sf), offset.scale(sf));
+        let local = crate::scene::PaintTransform {
+            scale,
+            offset: point(ScaledPixels(o.x.0 * (1.0 - scale) + d.x.0), ScaledPixels(o.y.0 * (1.0 - scale) + d.y.0)),
+            clip: self.content_mask().scale(sf).bounds,
+        };
+        let previous = self.next_frame.scene.transform;
+        self.next_frame.scene.transform = Some(match previous {
+            None => local,
+            Some(outer) => crate::scene::PaintTransform {
+                scale: outer.scale * local.scale,
+                offset: point(
+                    ScaledPixels(outer.scale * local.offset.x.0 + outer.offset.x.0),
+                    ScaledPixels(outer.scale * local.offset.y.0 + outer.offset.y.0),
+                ),
+                clip: outer.clip,
+            },
+        });
+        let result = f(self);
+        self.next_frame.scene.transform = previous;
+        result
+    }
