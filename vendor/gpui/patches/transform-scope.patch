+    }
+    fn corners(&self, c: Corners<ScaledPixels>) -> Corners<ScaledPixels> {
+        Corners { top_left: self.len(c.top_left), top_right: self.len(c.top_right), bottom_right: self.len(c.bottom_right), bottom_left: self.len(c.bottom_left) }
+    }
+    fn edges(&self, e: Edges<ScaledPixels>) -> Edges<ScaledPixels> {
+        Edges { top: self.len(e.top), right: self.len(e.right), bottom: self.len(e.bottom), left: self.len(e.left) }
+    }
