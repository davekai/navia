# The one place the app's identity lives for packaging. Change APP_ID here and APP_ID in
# crates/navia-core/src/client/mod.rs together. build-release.sh refuses to build if they differ.

# Package and command name.
APP_NAME=navia
# The app ID: the Wayland app_id, the desktop file, icon and metainfo names, and the Flatpak ID.
# Desktops match the window to "$APP_ID.desktop" by it.
APP_ID=com.davekai.Navia
APP_DISPLAY_NAME=Navia
APP_SUMMARY="Music client for Navidrome"
APP_MAINTAINER="Navia maintainers <maintainers@navia.invalid>"
